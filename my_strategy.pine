// ——————————— <↑↑↑ G_SCRIPT01 ↑↑↑>

//<triggers>
leTrigger    = ta.crossover (closeSeriesAlt, openSeriesAlt)
seTrigger    = ta.crossunder(closeSeriesAlt, openSeriesAlt)
lxTrigger    = seTrigger
sxTrigger    = leTrigger

G_RISK       = '■ ' + 'Risk Management'
//#region ———— <↓↓↓ G_RISK ↓↓↓> {

// ——————————— <constant_declarations>
//Tooltip
T_LVL        = '(%) Exit Level'
T_QTY        = '(%) Adjust trade exit volume'
T_MSG        = 'Paste JSON message for your bot'
//Webhook Message
O_LEMSG      = 'Long Entry'
O_LXMSGSL    = 'Long SL'
O_LXMSGTP1   = 'Long TP1'
O_LXMSGTP2   = 'Long TP2'
O_LXMSGTP3   = 'Long TP3'
O_LXMSG      = 'Long Exit'
O_SEMSG      = 'Short Entry'
O_SXMSGSL    = 'Short SL'
O_SXMSGA     = 'Short TP1'
O_SXMSGB     = 'Short TP2'
O_SXMSGC     = 'Short TP3'
O_SXMSGX     = 'Short Exit'

// ——————————— <input>          |           |                               |                        Line length guide |
i_lxLvlTP1   = input.float      (1,         'Level TP1'                     , group = G_RISK,
     tooltip =                   T_LVL)
i_lxQtyTP1   = input.float      (50,        'Qty   TP1'                     , group = G_RISK,
     tooltip =                   T_QTY)
i_lxLvlTP2   = input.float      (1.5,       'Level TP2'                     , group = G_RISK,
     tooltip =                   T_LVL)
i_lxQtyTP2   = input.float      (20,        'Qty   TP2'                     , group = G_RISK,
     tooltip =                   T_QTY)
i_lxLvlTP3   = input.float      (2,         'Level TP3'                     , group = G_RISK,
     tooltip =                   T_LVL)
i_lxQtyTP3   = input.float      (30,        'Runner Qty'                    , group = G_RISK,
     tooltip =                   T_QTY)
i_lxLvlSL    = input.float      (0.5,       'Stop Loss'                     , group = G_RISK,
     tooltip =                   T_LVL)

// ATR volatility targets
useAtrTargets = input.bool(true, "Use ATR based TP/SL", group = G_RISK)

atrTargetLen = input.int(14, "ATR Length", group = G_RISK)

slAtrMult  = input.float(1.3, "SL ATR Multiplier", step = 0.1, group = G_RISK)
tp1AtrMult = input.float(1.2, "TP1 ATR Multiplier", step = 0.1, group = G_RISK)
tp2AtrMult = input.float(2.0, "TP2 ATR Multiplier", step = 0.1, group = G_RISK)
tp3AtrMult = input.float(3.0, "TP3 ATR Multiplier", step = 0.1, group = G_RISK)
useBreakEvenAfterTp1 = input.bool(true, "Move SL to BE after TP1", group = G_RISK)
breakEvenAtrOffset = input.float(0.05, "BE ATR Offset", step = 0.01, group = G_RISK)
useTrendFilter = input.bool(true, 'Use Trend Filter', group = G_RISK)
trendFilterTf = input.timeframe('60', 'Trend Filter Timeframe', group = G_RISK)

atrTarget = ta.atr(atrTargetLen)
trendFilterClose = request.security(syminfo.tickerid, trendFilterTf, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
trendEma = request.security(syminfo.tickerid, trendFilterTf, ta.ema(close, 200), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
allowLongTrend = not useTrendFilter or trendFilterClose > trendEma
allowShortTrend = not useTrendFilter or trendFilterClose < trendEma

i_sxLvlTP1   = i_lxLvlTP1
i_sxQtyTP1   = i_lxQtyTP1
i_sxLvlTP2   = i_lxLvlTP2
i_sxQtyTP2   = i_lxQtyTP2
i_sxLvlTP3   = i_lxLvlTP3
i_sxQtyTP3   = i_lxQtyTP3
i_sxLvlSL    = i_lxLvlSL

G_MSG        = '■ ' + 'Webhook Message'
i_leMsg      = input.string     (O_LEMSG   ,'Long Entry'                   , group = G_MSG, tooltip = T_MSG)
i_lxMsgSL    = input.string     (O_LXMSGSL ,'Long SL'                      , group = G_MSG, tooltip = T_MSG)
i_lxMsgTP1   = input.string     (O_LXMSGTP1,'Long TP1'                     , group = G_MSG, tooltip = T_MSG)
i_lxMsgTP2   = input.string     (O_LXMSGTP2,'Long TP2'                     , group = G_MSG, tooltip = T_MSG)
i_lxMsgTP3   = input.string     (O_LXMSGTP3,'Long TP3'                     , group = G_MSG, tooltip = T_MSG)
i_lxMsg      = input.string     (O_LXMSG   ,'Long Exit'                    , group = G_MSG, tooltip = T_MSG)
i_seMsg      = input.string     (O_SEMSG   ,'Short Entry'                  , group = G_MSG, tooltip = T_MSG)
i_sxMsgSL    = input.string     (O_SXMSGSL ,'Short SL'                     , group = G_MSG, tooltip = T_MSG)
i_sxMsgTP1   = input.string     (O_SXMSGA  ,'Short TP1'                    , group = G_MSG, tooltip = T_MSG)
i_sxMsgTP2   = input.string     (O_SXMSGB  ,'Short TP2'                    , group = G_MSG, tooltip = T_MSG)
i_sxMsgTP3   = input.string     (O_SXMSGC  ,'Short TP3'                    , group = G_MSG, tooltip = T_MSG)
i_sxMsg      = input.string     (O_SXMSGX  ,'Short Exit'                   , group = G_MSG, tooltip = T_MSG)
i_src        = close


//──────────────────────────────────────────────────────────────────────────────
// WEBHOOK INTEGRATION (ADDED ONLY - NO LOGIC REMOVED)
//──────────────────────────────────────────────────────────────────────────────
G_WEBHOOK          = '■ ' + 'Webhook Integration'
useWebhookJson     = input.bool(true,  'Use JSON Webhook Messages', group = G_WEBHOOK)
tvSecret           = input.string('Smartconnect4u',  'Webhook Secret',            group = G_WEBHOOK)
instrumentKeyInput = input.string('',  'Instrument Key Override',   group = G_WEBHOOK)
instrumentKey      = instrumentKeyInput == '' ? syminfo.ticker : instrumentKeyInput
orderQty           = input.float(10.0,  'Order Quantity',            group = G_WEBHOOK, step = 0.01)
strategyTag        = input.string('SAIYAN_OCC', 'Strategy Tag',     group = G_WEBHOOK)
accountTag         = input.string('',  'Account Tag',               group = G_WEBHOOK)
sendSymbolId       = input.bool(true,  'Send TradingView Symbol',   group = G_WEBHOOK)
sendCommentTag     = input.bool(true,  'Send Comment/Reason',       group = G_WEBHOOK)

f_json_str(_s) =>
    _txt = str.tostring(_s)
    '"' + str.replace_all(str.replace_all(_txt, "\\", "\\\\"), '"', '\\"') + '"'

f_json_num(_n) =>
    str.tostring(_n)

f_side_norm(_side) =>
    _sideLower = str.lower(_side)
    _result = _sideLower
    if _sideLower == 'long'
        _result := 'buy'
    else if _sideLower == 'short'
        _result := 'sell'
    _result

f_event_json(_event, _side, _reason, _setup, _regime, _price, _sl, _tp1, _tp2, _tp3) =>
    _json = "{"
    _json := _json + '"secret":' + f_json_str(tvSecret) + ","
    _json := _json + '"event":' + f_json_str(_event) + ","
    _json := _json + '"side":' + f_json_str(f_side_norm(_side)) + ","
    _json := _json + '"instrument":' + f_json_str(instrumentKey) + ","
    _json := _json + '"ticker":' + (sendSymbolId ? f_json_str(syminfo.tickerid) : f_json_str("")) + ","
    _json := _json + '"exchange":' + f_json_str(syminfo.prefix) + ","
    _json := _json + '"strategy":' + f_json_str(strategyTag) + ","
    _json := _json + '"account":' + f_json_str(accountTag) + ","
    _json := _json + '"quantity":' + f_json_num(orderQty) + ","
    _json := _json + '"price":' + f_json_num(_price) + ","
    _json := _json + '"sl":' + f_json_num(_sl) + ","
    _json := _json + '"tp1":' + f_json_num(_tp1) + ","
    _json := _json + '"tp2":' + f_json_num(_tp2) + ","
    _json := _json + '"tp3":' + f_json_num(_tp3) + ","
    _json := _json + '"reason":' + f_json_str(_reason) + ","
    _json := _json + '"setup":' + f_json_str(_setup) + ","
    _json := _json + '"regime":' + f_json_str(_regime) + ","
    _json := _json + '"tf":' + f_json_str(timeframe.period) + ","
    _json := _json + '"bar_time":' + f_json_str(str.tostring(time)) + ","
    _json := _json + '"comment":' + f_json_str(sendCommentTag ? _reason : "")
    _json := _json + "}"
    _json

f_entry_json(_side, _reason, _setup, _regime, _sl, _tp1, _tp2, _tp3) =>
    f_event_json('entry', _side, _reason, _setup, _regime, close, _sl, _tp1, _tp2, _tp3)

f_exit_json(_side, _reason, _setup, _regime, _sl, _tp1, _tp2, _tp3) =>
    f_event_json('exit', _side, _reason, _setup, _regime, close, _sl, _tp1, _tp2, _tp3)

f_close_json(_side, _reason, _setup, _regime, _sl, _tp1, _tp2, _tp3) =>
    f_event_json('close', _side, _reason, _setup, _regime, close, _sl, _tp1, _tp2, _tp3)


G_DISPLAY    = 'Display'
//<display>
i_alertOn    = input.bool       (true,      'Alert Labels On/Off'          , group = G_DISPLAY)
i_barColOn   = input.bool       (true,      'Bar Color On/Off'             , group = G_DISPLAY)

// ——————————— <function_declarations>
// @function        Calculate the Take Profit line, and the crossover or crossunder
f_tp(_condition, _conditionValue, _leTrigger, _seTrigger, _src, _lxLvlTP, _sxLvlTP)=>
    var float _tpLine = 0.0
    _topLvl     = _src + (_src * (_lxLvlTP / 100))
    _botLvl     = _src - (_src * (_sxLvlTP / 100))
    _tpLine    := _condition[1] !=  _conditionValue and _leTrigger ? _topLvl :
                  _condition[1] != -_conditionValue and _seTrigger ? _botLvl :
                  nz(_tpLine[1])
    [_tpLine]

// @function        Similar to "ta.crossover" or "ta.crossunder"
f_cross(_scr1, _scr2, _over)=>
    _cross   = _over ? _scr1 > _scr2 and _scr1[1] < _scr2[1] :
                       _scr1 < _scr2 and _scr1[1] > _scr2[1]

// ——————————— <calculations>
//<set initial values>
var float condition = 0.0
var float slLine    = 0.0
var float entryLine = 0.0
var bool  tp1Touched = false
var bool  tp2Touched = false
var bool  tp1Done    = false
var bool  tp2Done    = false

//<entry & exit orders>
entryLine   := leTrigger and condition[1] <=  0.0 ? close :
               seTrigger and condition[1] >=  0.0 ? close : nz(entryLine[1])
//<SL>
// % SL
slTopLvlPct = i_src + (i_src * (i_lxLvlSL / 100))
slBotLvlPct = i_src - (i_src * (i_sxLvlSL / 100))

// ATR SL
slTopLvlAtr = entryLine + (atrTarget * slAtrMult)
slBotLvlAtr = entryLine - (atrTarget * slAtrMult)

slLine := condition[1] <= 0.0 and leTrigger ? (useAtrTargets ? slBotLvlAtr : slBotLvlPct) :
          condition[1] >= 0.0 and seTrigger ? (useAtrTargets ? slTopLvlAtr : slTopLvlPct) :
          nz(slLine[1])

if useBreakEvenAfterTp1 and tp1Done and condition[1] >= 1.0
    slLine := math.max(slLine, entryLine + atrTarget * breakEvenAtrOffset)
else if useBreakEvenAfterTp1 and tp1Done and condition[1] <= -1.0
    slLine := math.min(slLine, entryLine - atrTarget * breakEvenAtrOffset)

slLong      = f_cross(low,  slLine, false)
slShort     = f_cross(high, slLine, true )
//<TP1, TP2 & TP3>
// % TP
[tp3LinePct] = f_tp(condition, 1.2, leTrigger, seTrigger, i_src, i_lxLvlTP3, i_sxLvlTP3)
[tp2LinePct] = f_tp(condition, 1.1, leTrigger, seTrigger, i_src, i_lxLvlTP2, i_sxLvlTP2)
[tp1LinePct] = f_tp(condition, 1.0, leTrigger, seTrigger, i_src, i_lxLvlTP1, i_sxLvlTP1)

// ATR TP
tp3LineAtr = condition >= 1.0 ? entryLine + atrTarget * tp3AtrMult : entryLine - atrTarget * tp3AtrMult
tp2LineAtr = condition >= 1.0 ? entryLine + atrTarget * tp2AtrMult : entryLine - atrTarget * tp2AtrMult
tp1LineAtr = condition >= 1.0 ? entryLine + atrTarget * tp1AtrMult : entryLine - atrTarget * tp1AtrMult

tp3Line = useAtrTargets ? tp3LineAtr : tp3LinePct
tp2Line = useAtrTargets ? tp2LineAtr : tp2LinePct
tp1Line = useAtrTargets ? tp1LineAtr : tp1LinePct

newLongTrade  = leTrigger and condition[1] <=  0.0
newShortTrade = seTrigger and condition[1] >=  0.0
longStagePrev = condition[1] >=  1.0
shortStagePrev = condition[1] <= -1.0

if newLongTrade or newShortTrade
    tp1Touched := false
    tp2Touched := false
    tp1Done := false
    tp2Done := false

if newLongTrade
    tp1Touched := high >= tp1Line
    tp2Touched := high >= tp2Line
else if newShortTrade
    tp1Touched := low <= tp1Line
    tp2Touched := low <= tp2Line
else if condition[1] >= 1.0
    tp1Touched := tp1Touched or high >= tp1Line
    tp2Touched := tp2Touched or high >= tp2Line
else if condition[1] <= -1.0
    tp1Touched := tp1Touched or low <= tp1Line
    tp2Touched := tp2Touched or low <= tp2Line

tp3Long      = f_cross(high, tp3Line, true )
tp3Short     = f_cross(low,  tp3Line, false)
tp1Long      = longStagePrev  and tp1Touched and not tp1Done
tp1Short     = shortStagePrev and tp1Touched and not tp1Done
tp2Long      = longStagePrev  and tp2Touched and not tp2Done and (tp1Done or (condition[1] == 1.0 and tp1Long))
tp2Short     = shortStagePrev and tp2Touched and not tp2Done and (tp1Done or (condition[1] == -1.0 and tp1Short))

cooldownBars = input.int(1, 'Cooldown Bars', minval = 0, group = G_RISK)
var int lastTradeBar = na
canTrade = na(lastTradeBar) or (bar_index - lastTradeBar > cooldownBars)

useSlopeFilter  = input.bool(true, 'Use Slope Filter', group = G_RISK)
slopeLookback   = input.int(3, 'Slope Lookback', minval = 1, group = G_RISK)
minSlope        = input.float(0.05, 'Min Slope ATR', step = 0.05, group = G_RISK)
maSlope         = closeSeriesAlt - closeSeriesAlt[slopeLookback]
maSlopeAtr      = atrTarget != 0 ? maSlope / atrTarget : 0.0
allowLongSlope  = not useSlopeFilter or maSlopeAtr > minSlope
allowShortSlope = not useSlopeFilter or maSlopeAtr < -minSlope

useVolatilityFilter = input.bool(true, 'Use Volatility Filter', group = G_RISK)
atrFastLen = input.int(14, 'ATR Fast Length', minval = 1, group = G_RISK)
atrSlowLen = input.int(50, 'ATR Slow Length', minval = 2, group = G_RISK)
volatilityThreshold = input.float(0.85, 'Volatility Threshold', minval = 0.1, step = 0.05, group = G_RISK)
atrFast = ta.atr(atrFastLen)
atrSlow = ta.sma(atrFast, atrSlowLen)
volatilityOK = not useVolatilityFilter or atrFast > atrSlow * volatilityThreshold

useRsiExhaustionFilter = input.bool(false, 'Avoid RSI Exhaustion', group = G_RISK)
rsiExhaustionLen = input.int(14, 'RSI Exhaustion Length', minval = 2, group = G_RISK)
rsiLongMax = input.float(80, 'Max RSI for Long', minval = 50, maxval = 100, step = 0.5, group = G_RISK)
rsiShortMin = input.float(20, 'Min RSI for Short', minval = 0, maxval = 50, step = 0.5, group = G_RISK)
rsiExhaustion = ta.rsi(close, rsiExhaustionLen)
rsiLongOK = not useRsiExhaustionFilter or rsiExhaustion < rsiLongMax
rsiShortOK = not useRsiExhaustionFilter or rsiExhaustion > rsiShortMin

G_SCALPER = '■ ' + 'PRO Scalper Filters'
useScalperVwapFilter = input.bool(false, 'Use Session VWAP Filter', group = G_SCALPER)
showScalperVwap = input.bool(false, 'Plot Session VWAP', group = G_SCALPER)
useScalperOrFilter = input.bool(false, 'Use Opening Range Filter', group = G_SCALPER)
showScalperOr = input.bool(false, 'Plot Opening Range', group = G_SCALPER)
scalperOrAutoK = input.float(3.0, 'OR: Auto K x TF minutes', step = 0.5, group = G_SCALPER)
scalperOrMin = input.int(30, 'OR: Manual minutes', minval = 1, group = G_SCALPER)
scalperOrMode = input.string('Auto', 'OR Length Mode', options = ['Auto', 'Manual'], group = G_SCALPER)
scalperOrTradeMode = input.string('Breakout', 'OR Trade Mode', options = ['Breakout', 'Avoid Inside'], group = G_SCALPER)
useScalperTrendFilter = input.bool(true, 'Use EMA+ADX Trend Filter', group = G_SCALPER)
scalperUseHTF = input.bool(true, 'Use HTF for Trend Filter', group = G_SCALPER)
scalperTfHTF = input.timeframe('60', 'Trend HTF', group = G_SCALPER)
scalperEmaFastLen = input.int(34, 'EMA Fast', minval = 1, group = G_SCALPER)
scalperEmaSlowLen = input.int(89, 'EMA Slow', minval = 2, group = G_SCALPER)
scalperAdxLen = input.int(14, 'ADX Len', minval = 1, group = G_SCALPER)
scalperAdxThr = input.float(18, 'ADX >=', step = 0.5, group = G_SCALPER)
showScalperTrend = input.bool(false, 'Plot EMA Filter', group = G_SCALPER)
useScalperDeltaFilter = input.bool(false, 'Use Delta Spike Confirmation', group = G_SCALPER)
scalperDeltaMode = input.string('RangeWeighted', 'Delta Proxy', options = ['RangeWeighted', 'CloseVsPrev', 'CloseVsOpen'], group = G_SCALPER)
scalperDeltaLen = input.int(200, 'Delta Quantile Lookback', minval = 50, group = G_SCALPER)
scalperDeltaPct = input.float(85, 'Delta Quantile %', step = 0.5, minval = 50, maxval = 99.9, group = G_SCALPER)

scalperNewSess = ta.change(time('D')) != 0
var float scalperCumPV = na
var float scalperCumV = na
if scalperNewSess or na(scalperCumPV)
    scalperCumPV := 0.0
    scalperCumV := 0.0
scalperCumPV += hlc3 * volume
scalperCumV += volume
scalperVwap = scalperCumV > 0 ? scalperCumPV / scalperCumV : na

scalperTfMin = f_chartTfInMinutes()
scalperOrLenMin = scalperOrMode == 'Auto' ? scalperOrAutoK * scalperTfMin : scalperOrMin
scalperOrBars = math.max(1, int(math.ceil(scalperOrLenMin / math.max(scalperTfMin, 1))))
var float scalperOrHigh = na
var float scalperOrLow = na
var int scalperBarsFromOpen = 0
if scalperNewSess
    scalperOrHigh := na
    scalperOrLow := na
    scalperBarsFromOpen := 0
if scalperBarsFromOpen < scalperOrBars
    scalperOrHigh := na(scalperOrHigh) ? high : math.max(scalperOrHigh, high)
    scalperOrLow := na(scalperOrLow) ? low : math.min(scalperOrLow, low)
    scalperBarsFromOpen += 1

f_scalper_adx(_len) =>
    upMove = high - high[1]
    downMove = low[1] - low
    plusDM = upMove > downMove and upMove > 0 ? upMove : 0.0
    minusDM = downMove > upMove and downMove > 0 ? downMove : 0.0
    trValue = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
    smTR = ta.rma(trValue, _len)
    smP = ta.rma(plusDM, _len)
    smM = ta.rma(minusDM, _len)
    plusDI = smTR != 0 ? 100.0 * smP / smTR : 0.0
    minusDI = smTR != 0 ? 100.0 * smM / smTR : 0.0
    dxValue = plusDI + minusDI != 0 ? 100.0 * math.abs(plusDI - minusDI) / (plusDI + minusDI) : 0.0
    ta.rma(dxValue, _len)

scalperTrendSrc = scalperUseHTF ? request.security(syminfo.tickerid, scalperTfHTF, close, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off) : close
scalperEmaFast = ta.ema(scalperTrendSrc, scalperEmaFastLen)
scalperEmaSlow = ta.ema(scalperTrendSrc, scalperEmaSlowLen)
scalperAdx = scalperUseHTF ? request.security(syminfo.tickerid, scalperTfHTF, f_scalper_adx(scalperAdxLen), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off) : f_scalper_adx(scalperAdxLen)
scalperTrendUp = scalperEmaFast > scalperEmaSlow

scalperRange = math.max(high - low, syminfo.mintick)
scalperDeltaRW = scalperRange > 0 ? volume * (close - open) / scalperRange : 0.0
scalperDeltaCP = close >= close[1] ? volume : -volume
scalperDeltaCO = close >= open ? volume : -volume
scalperDelta = scalperDeltaMode == 'RangeWeighted' ? scalperDeltaRW : scalperDeltaMode == 'CloseVsOpen' ? scalperDeltaCO : scalperDeltaCP
scalperAbsDelta = math.abs(scalperDelta)
scalperDeltaThreshold = ta.percentile_linear_interpolation(scalperAbsDelta, scalperDeltaLen, scalperDeltaPct)

scalperLongVwapOK = not useScalperVwapFilter or na(scalperVwap) or close > scalperVwap
scalperShortVwapOK = not useScalperVwapFilter or na(scalperVwap) or close < scalperVwap
scalperOutsideOr = not na(scalperOrHigh) and not na(scalperOrLow) and (close > scalperOrHigh or close < scalperOrLow)
scalperLongOrOK = not useScalperOrFilter or na(scalperOrHigh) or (scalperOrTradeMode == 'Breakout' ? close > scalperOrHigh : scalperOutsideOr)
scalperShortOrOK = not useScalperOrFilter or na(scalperOrLow) or (scalperOrTradeMode == 'Breakout' ? close < scalperOrLow : scalperOutsideOr)
scalperLongTrendOK = not useScalperTrendFilter or (scalperTrendUp and scalperAdx >= scalperAdxThr)
scalperShortTrendOK = not useScalperTrendFilter or (not scalperTrendUp and scalperAdx >= scalperAdxThr)
scalperBullDeltaSpike = scalperDelta > 0 and scalperAbsDelta >= math.max(scalperDeltaThreshold, 1)
scalperBearDeltaSpike = scalperDelta < 0 and scalperAbsDelta >= math.max(scalperDeltaThreshold, 1)
scalperLongDeltaOK = not useScalperDeltaFilter or scalperBullDeltaSpike
scalperShortDeltaOK = not useScalperDeltaFilter or scalperBearDeltaSpike

plot(showScalperVwap ? scalperVwap : na, 'PRO VWAP', color = color.new(color.yellow, 0), linewidth = 2)
plot(showScalperOr ? scalperOrHigh : na, 'PRO OR High', color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)
plot(showScalperOr ? scalperOrLow : na, 'PRO OR Low', color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)
plot(showScalperTrend ? scalperEmaFast : na, 'PRO EMA Fast', color = color.new(color.teal, 0))
plot(showScalperTrend ? scalperEmaSlow : na, 'PRO EMA Slow', color = color.new(color.orange, 0))

allowLongTradeType  = tradeType == 'LONG' or tradeType == 'BOTH'
allowShortTradeType = tradeType == 'SHORT' or tradeType == 'BOTH'
longSignalAllowed   = allowLongTradeType and allowLongTrend and allowLongSlope and volatilityOK and rsiLongOK and canTrade and scalperLongVwapOK and scalperLongOrOK and scalperLongTrendOK and scalperLongDeltaOK and tl_long_filter_ok
shortSignalAllowed  = allowShortTradeType and allowShortTrend and allowShortSlope and volatilityOK and rsiShortOK and canTrade and scalperShortVwapOK and scalperShortOrOK and scalperShortTrendOK and scalperShortDeltaOK and tl_short_filter_ok

condition := nz(condition[1])
if longStagePrev
    bool longAdvanced = false
    if tp1Long and condition[1] == 1.0
        condition := 1.1
        longAdvanced := true
    if tp2Long and (condition[1] == 1.1 or condition == 1.1)
        condition := 1.2
        longAdvanced := true
    if tp3Long and (condition[1] == 1.2 or condition == 1.2)
        condition := 0.0
        longAdvanced := true
    if not longAdvanced
        if slLong and condition[1] >= 1.0
            condition := 0.0
        else if lxTrigger and shortSignalAllowed and condition[1] >= 1.0
            condition := -1.0
        else if lxTrigger and condition[1] >= 1.0
            condition := 0.0
else if shortStagePrev
    bool shortAdvanced = false
    if tp1Short and condition[1] == -1.0
        condition := -1.1
        shortAdvanced := true
    if tp2Short and (condition[1] == -1.1 or condition == -1.1)
        condition := -1.2
        shortAdvanced := true
    if tp3Short and (condition[1] == -1.2 or condition == -1.2)
        condition := 0.0
        shortAdvanced := true
    if not shortAdvanced
        if slShort and condition[1] <= -1.0
            condition := 0.0
        else if sxTrigger and longSignalAllowed and condition[1] <= -1.0
            condition := 1.0
        else if sxTrigger and condition[1] <= -1.0
            condition := 0.0
else if leTrigger and longSignalAllowed and condition[1] <= 0.0
    condition := 1.0
else if seTrigger and shortSignalAllowed and condition[1] >= 0.0
    condition := -1.0

longE        = leTrigger and condition != condition[1] and condition ==  1.0
shortE       = seTrigger and condition != condition[1] and condition == -1.0
longX        = lxTrigger and condition[1] >=  1.0 and condition ==  0.0
shortX       = sxTrigger and condition[1] <= -1.0 and condition ==  0.0
longSL       = slLong    and condition[1] >=  1.0 and condition ==  0.0 and not longX
shortSL      = slShort   and condition[1] <= -1.0 and condition ==  0.0 and not shortX
longTP3      = tp3Long   and condition[1] ==  1.2 and condition ==  0.0
shortTP3     = tp3Short  and condition[1] == -1.2 and condition ==  0.0
longTP1      = tp1Long   and condition[1] ==  1.0 and condition ==  1.1
shortTP1     = tp1Short  and condition[1] == -1.0 and condition == -1.1
longTP2      = tp2Long   and (condition[1] ==  1.1 or (condition[1] == 1.0 and longTP1)) and condition >= 1.2
shortTP2     = tp2Short  and (condition[1] == -1.1 or (condition[1] == -1.0 and shortTP1)) and condition <= -1.2

// Build webhook SL/TP explicitly from trade side so entry alerts never inherit
// the wrong direction from transient state on the signal bar.
longSlWebhook  = useAtrTargets ? entryLine - atrTarget * slAtrMult  : entryLine - entryLine * (i_lxLvlSL / 100)
shortSlWebhook = useAtrTargets ? entryLine + atrTarget * slAtrMult  : entryLine + entryLine * (i_sxLvlSL / 100)
longTp1Webhook = useAtrTargets ? entryLine + atrTarget * tp1AtrMult : entryLine + entryLine * (i_lxLvlTP1 / 100)
longTp2Webhook = useAtrTargets ? entryLine + atrTarget * tp2AtrMult : entryLine + entryLine * (i_lxLvlTP2 / 100)
longTp3Webhook = useAtrTargets ? entryLine + atrTarget * tp3AtrMult : entryLine + entryLine * (i_lxLvlTP3 / 100)
shortTp1Webhook = useAtrTargets ? entryLine - atrTarget * tp1AtrMult : entryLine - entryLine * (i_sxLvlTP1 / 100)
shortTp2Webhook = useAtrTargets ? entryLine - atrTarget * tp2AtrMult : entryLine - entryLine * (i_sxLvlTP2 / 100)
shortTp3Webhook = useAtrTargets ? entryLine - atrTarget * tp3AtrMult : entryLine - entryLine * (i_sxLvlTP3 / 100)

//──────────────────────────────────────────────────────────────────────────────
// RUNTIME WEBHOOK MESSAGES (ADDED ONLY - NO LOGIC REMOVED)
//──────────────────────────────────────────────────────────────────────────────
leWebhookMsg    = useWebhookJson ? f_entry_json('long' , 'LE'   , 'MA_CROSS', 'trend', longSlWebhook, longTp1Webhook, longTp2Webhook, longTp3Webhook) : i_leMsg
seWebhookMsg    = useWebhookJson ? f_entry_json('short', 'SE'   , 'MA_CROSS', 'trend', shortSlWebhook, shortTp1Webhook, shortTp2Webhook, shortTp3Webhook) : i_seMsg

lxMsgSLWebhook  = useWebhookJson ? f_exit_json ('long' , 'SL'   , 'MA_CROSS', 'trend', longSlWebhook, longTp1Webhook, longTp2Webhook, longTp3Webhook) : i_lxMsgSL
lxMsgTP1Webhook = useWebhookJson ? f_exit_json ('long' , 'LXTP1', 'MA_CROSS', 'trend', longSlWebhook, longTp1Webhook, longTp2Webhook, longTp3Webhook) : i_lxMsgTP1
lxMsgTP2Webhook = useWebhookJson ? f_exit_json ('long' , 'LXTP2', 'MA_CROSS', 'trend', longSlWebhook, longTp1Webhook, longTp2Webhook, longTp3Webhook) : i_lxMsgTP2
lxMsgTP3Webhook = useWebhookJson ? f_exit_json ('long' , 'LXTP3', 'MA_CROSS', 'trend', longSlWebhook, longTp1Webhook, longTp2Webhook, longTp3Webhook) : i_lxMsgTP3
lxMsgWebhook    = useWebhookJson ? f_close_json('long' , 'LX'   , 'MA_CROSS', 'trend', longSlWebhook, longTp1Webhook, longTp2Webhook, longTp3Webhook) : i_lxMsg

sxMsgSLWebhook  = useWebhookJson ? f_exit_json ('short', 'SL'   , 'MA_CROSS', 'trend', shortSlWebhook, shortTp1Webhook, shortTp2Webhook, shortTp3Webhook) : i_sxMsgSL
sxMsgTP1Webhook = useWebhookJson ? f_exit_json ('short', 'SXTP1', 'MA_CROSS', 'trend', shortSlWebhook, shortTp1Webhook, shortTp2Webhook, shortTp3Webhook) : i_sxMsgTP1
sxMsgTP2Webhook = useWebhookJson ? f_exit_json ('short', 'SXTP2', 'MA_CROSS', 'trend', shortSlWebhook, shortTp1Webhook, shortTp2Webhook, shortTp3Webhook) : i_sxMsgTP2
sxMsgTP3Webhook = useWebhookJson ? f_exit_json ('short', 'SXTP3', 'MA_CROSS', 'trend', shortSlWebhook, shortTp1Webhook, shortTp2Webhook, shortTp3Webhook) : i_sxMsgTP3
sxMsgWebhook    = useWebhookJson ? f_close_json('short', 'SX'   , 'MA_CROSS', 'trend', shortSlWebhook, shortTp1Webhook, shortTp2Webhook, shortTp3Webhook) : i_sxMsg


// ——————————— <strategy_calls> {
//<long orders>
if strategy.position_size <= 0 and longE and barstate.isconfirmed
    strategy.entry(
      'Long',
      strategy.long,
      alert_message    = leWebhookMsg,
      comment          = 'LE')
    lastTradeBar := bar_index
if condition >= 1.0 and longTP1 and barstate.isconfirmed
    strategy.close(
      'Long',
      qty_percent      = i_lxQtyTP1,
      alert_message    = lxMsgTP1Webhook,
      comment          = 'LXTP1')
if condition >= 1.0 and longTP2 and barstate.isconfirmed
    strategy.close(
      'Long',
      qty_percent      = i_lxQtyTP2,
      alert_message    = lxMsgTP2Webhook,
      comment          = 'LXTP2')
if longTP3 and barstate.isconfirmed
    strategy.close(
      'Long',
      qty_percent      = i_lxQtyTP3,
      alert_message    = lxMsgTP3Webhook,
      comment          = 'LXTP3')
if strategy.position_size > 0 and longSL and barstate.isconfirmed
    strategy.close(
      'Long',
      alert_message    = lxMsgSLWebhook,
      comment          = 'SL')
if strategy.position_size > 0 and longX and barstate.isconfirmed
    strategy.close(
      'Long',
      alert_message    = lxMsgWebhook,
      comment          = 'Close')
//<short orders>
if strategy.position_size >= 0 and shortE and barstate.isconfirmed
    strategy.entry(
      'Short',
      strategy.short,
      alert_message    = seWebhookMsg,
      comment          = 'SE')
    lastTradeBar := bar_index
if condition <= -1.0 and shortTP1 and barstate.isconfirmed
    strategy.close(
      'Short',
      qty_percent      = i_sxQtyTP1,
      alert_message    = sxMsgTP1Webhook,
      comment          = 'SXTP1')
if condition <= -1.0 and shortTP2 and barstate.isconfirmed
    strategy.close(
      'Short',
      qty_percent      = i_sxQtyTP2,
      alert_message    = sxMsgTP2Webhook,
      comment          = 'SXTP2')
if shortTP3 and barstate.isconfirmed
    strategy.close(
      'Short',
      qty_percent      = i_sxQtyTP3,
      alert_message    = sxMsgTP3Webhook,
      comment          = 'SXTP3')
if strategy.position_size < 0 and shortSL and barstate.isconfirmed
    strategy.close(
      'Short',
      alert_message    = sxMsgSLWebhook,
      comment          = 'SL')
if strategy.position_size < 0 and shortX and barstate.isconfirmed
    strategy.close(
      'Short',
      alert_message    = sxMsgWebhook,
      comment          = 'Close')

if longTP1 or shortTP1
    tp1Done := true
if longTP2 or shortTP2
    tp2Done := true
if longTP3 or shortTP3 or longSL or shortSL or longX or shortX
    tp1Touched := false
    tp2Touched := false
    tp1Done := false
    tp2Done := false

// ——————————— <visuals>
c_tp         = leTrigger or seTrigger ? na :
               condition == 0.0       ? na : color.green
c_entry      = leTrigger or seTrigger ? na :
               condition == 0.0       ? na : color.blue
c_sl         = leTrigger or seTrigger ? na :
               condition == 0.0       ? na : color.red
p_tp1Line    = plot (
  condition ==  1.0 or
  condition == -1.0 ? tp1Line : na,
  title      = "TP Line 1",
  color      = c_tp,
  linewidth  = 1,
  style      = plot.style_linebr)
p_tp2Line    = plot (
  condition ==  1.0 or
  condition == -1.0 or
  condition ==  1.1 or
  condition == -1.1 ? tp2Line : na,
  title      = "TP Line 2",
  color      = c_tp,
  linewidth  = 1,
  style      = plot.style_linebr)
p_tp3Line    = plot (
  condition ==  1.0 or
  condition == -1.0 or
  condition ==  1.1 or
  condition == -1.1 or
  condition ==  1.2 or
  condition == -1.2 ? tp3Line : na,
  title      = "TP Line 3",
  color      = c_tp,
  linewidth  = 1,
  style      = plot.style_linebr)
p_entryLine  = plot (
  condition >=  1.0 or
  condition <= -1.0 ? entryLine : na,
  title      = "Entry Line",
  color      = c_entry,
  linewidth  = 1,
  style      = plot.style_linebr)
p_slLine     = plot (
  condition ==  1.0 or
  condition == -1.0 or
  condition ==  1.1 or
  condition == -1.1 or
  condition ==  1.2 or
  condition == -1.2 ? slLine : na,
  title      = "SL Line",
  color      = c_sl,
  linewidth  = 1,
  style      = plot.style_linebr)
fill(
  p_tp3Line, p_entryLine,
  color      = leTrigger or seTrigger ? na : color.new(color.green, 90))
fill(
  p_entryLine, p_slLine,
  color      = leTrigger or seTrigger ? na : color.new(color.red, 90))

//<alerts labels>
plotshape(
  i_alertOn and longE,
  title      = 'Long',
  text       = 'Long',
  textcolor  = color.white,
  color      = color.green,
  style      = shape.labelup,
  size       = size.tiny,
  location   = location.belowbar)
plotshape(
  i_alertOn and shortE,
  title      = 'Short',
  text       = 'Short',
  textcolor  = color.white,
  color      = color.red,
  style      = shape.labeldown,
  size       = size.tiny,
  location   = location.abovebar)
plotshape(
  i_alertOn and (longX or shortX) ? close : na,
  title      = 'Close',
  text       = 'Close',
  textcolor  = color.white,
  color      = color.gray,
  style      = shape.labelup,
  size       = size.tiny,
  location   = location.absolute)
l_tp         = i_alertOn and (longTP1 or shortTP1) ? close : na
plotshape(
  l_tp,
  title      = "TP1 Cross",
  text       = "TP1",
  textcolor  = color.white,
  color      = color.olive,
  style      = shape.labelup,
  size       = size.tiny,
  location   = location.absolute)
plotshape(
  i_alertOn and (longTP2 or shortTP2) ? close : na,
  title      = "TP2 Cross",
  text       = "TP2",
  textcolor  = color.white,
  color      = color.olive,
  style      = shape.labelup,
  size       = size.tiny,
  location   = location.absolute)
plotshape(
  i_alertOn and (longTP3 or shortTP3) ? close : na,
  title      = "TP3 Cross",
  text       = "TP3",
  textcolor  = color.white,
  color      = color.olive,
  style      = shape.labelup,
  size       = size.tiny,
  location   = location.absolute)
plotshape(
  i_alertOn and (longSL or shortSL) ? slLine : na,
  title      = "SL Cross",
  text       = "SL",
  textcolor  = color.white,
  color      = color.maroon,
  style      = shape.labelup,
  size       = size.tiny,
  location   = location.absolute)

//<debug>
plot(
  na,
  title      = "─── <debug> ───",
  editable   = false,
  display    = display.data_window)
plot(
  condition,
  title      = "condition",
  editable   = false,
  display    = display.data_window)
plot(
  strategy.position_size * 100,
  title      = ".position_size",
  editable   = false,
  display    = display.data_window)
//#endregion }
// ——————————— <↑↑↑ G_RISK ↑↑↑>

//#region ———— <↓↓↓ G_SCRIPT02 ↓↓↓> {
// @function        Queues a new element in an array and de-queues its first element.
f_qDq(_array, _val) =>
    array.push(_array, _val)
    _return = array.shift(_array)
    _return

var line[]  a_slLine     = array.new_line(1)
var line[]  a_entryLine  = array.new_line(1)
var line[]  a_tp3Line    = array.new_line(1)
var line[]  a_tp2Line    = array.new_line(1)
var line[]  a_tp1Line    = array.new_line(1)
var label[] a_slLabel    = array.new_label(1)
var label[] a_tp3label   = array.new_label(1)
var label[] a_tp2label   = array.new_label(1)
var label[] a_tp1label   = array.new_label(1)
var label[] a_entryLabel = array.new_label(1)

newEntry     = longE or shortE
tradeActive  = condition >= 1.0 or condition <= -1.0
var int entryIndex = na
entryIndex  := newEntry ? bar_index : nz(entryIndex[1])
lasTrade     = bar_index >= entryIndex
l_right      = 10

if tradeActive and not na(entryIndex)
    line.delete(
      f_qDq(a_slLine,
      line.new(
       entryIndex,
       slLine,
       last_bar_index + l_right,
       slLine,
       style = line.style_solid,
       color = c_sl)))
    line.delete(
      f_qDq(a_entryLine,
      line.new(
       entryIndex,
       entryLine,
       last_bar_index + l_right,
       entryLine,
       style = line.style_solid,
       color = color.blue)))
    line.delete(
      f_qDq(a_tp3Line,
      line.new(
       entryIndex,
       tp3Line,
       last_bar_index + l_right,
       tp3Line,
       style = line.style_solid,
       color = c_tp)))
    line.delete(
      f_qDq(a_tp2Line,
      line.new(
       entryIndex,
       tp2Line,
       last_bar_index + l_right,
       tp2Line,
       style = line.style_solid,
       color = c_tp)))
    line.delete(
      f_qDq(a_tp1Line,
      line.new(
       entryIndex,
       tp1Line,
       last_bar_index + l_right,
       tp1Line,
       style = line.style_solid,
       color = c_tp)))

    label.delete(
      f_qDq(a_slLabel,
      label.new(
       last_bar_index + l_right,
       slLine,
       'SL: ' + str.tostring(slLine, '##.###'),
       style = label.style_label_left,
       textcolor  = color.white,
       color = c_sl)))
    label.delete(
      f_qDq(a_entryLabel,
      label.new(
       last_bar_index + l_right,
       entryLine,
       'Entry: ' + str.tostring(entryLine, '##.###'),
       style = label.style_label_left,
       textcolor  = color.white,
       color = color.blue)))
    label.delete(
      f_qDq(a_tp3label,
      label.new(
       last_bar_index + l_right,
       tp3Line,
       'TP3: ' + str.tostring(tp3Line, '##.###'),
       style = label.style_label_left,
       textcolor  = color.white,
       color = c_tp)))
    label.delete(
      f_qDq(a_tp2label,
      label.new(
       last_bar_index + l_right,
       tp2Line,
       'TP2: ' + str.tostring(tp2Line, '##.###'),
       style = label.style_label_left,
       textcolor  = color.white,
       color = c_tp)))
    label.delete(
      f_qDq(a_tp1label,
      label.new(
       last_bar_index + l_right,
       tp1Line,
       'TP1: ' + str.tostring(tp1Line, '##.###'),
       style = label.style_label_left,
       textcolor  = color.white,
       color = c_tp)))
else
    line.delete(array.get(a_slLine, 0))
    line.delete(array.get(a_entryLine, 0))
    line.delete(array.get(a_tp3Line, 0))
    line.delete(array.get(a_tp2Line, 0))
    line.delete(array.get(a_tp1Line, 0))
    label.delete(array.get(a_slLabel, 0))
    label.delete(array.get(a_entryLabel, 0))
    label.delete(array.get(a_tp3label, 0))
    label.delete(array.get(a_tp2label, 0))
    label.delete(array.get(a_tp1label, 0))

//#endregion }
// ——————————— <↑↑↑ G_SCRIPT02 ↑↑↑>

//#region ———— <↓↓↓ G_SCRIPT03 ↓↓↓> {
c_barCol = close > open ? color.rgb(120, 9, 139) : color.rgb(69, 155, 225)
barcolor(
  i_barColOn ? c_barCol : na)
